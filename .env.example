# --- OpenDART(금융감독원 전자공시) 오픈 API 인증키 -----------------------------
# 발급: https://opendart.fss.or.kr/  >  인증키 신청/관리
# 이 파일을 .env 로 복사한 뒤 본인 키를 입력하세요. .env 는 Git 에 커밋되지 않습니다.
DART_API_KEY=

# --- Meta Model API (Muse Spark) --------------------------------------------
# 발급: https://dev.meta.ai/platform  >  API keys  (결제수단 등록이 선행되어야 함)
# Muse Wonder(muse-wonder-1.0)는 대한민국에서 제공되지 않습니다.
MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
FACTLENS_MUSE_MODEL=muse-spark-1.3
# FACTLENS_MUSE_REASONING=minimal
